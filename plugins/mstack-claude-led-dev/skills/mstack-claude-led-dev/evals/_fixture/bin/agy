#!/bin/sh
set -eu
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
standin="$here/../stand-in"
if [ $# -eq 1 ] && [ "$1" = "models" ]; then
  if [ -e "$standin/models-fail" ]; then
    echo "stand-in agy: models listing unavailable" >&2
    exit 1
  fi
  if [ ! -f "$standin/models.txt" ]; then
    echo "stand-in agy: missing models.txt" >&2
    exit 1
  fi
  cat "$standin/models.txt"
  exit 0
fi
echo "stand-in agy: only models" >&2
exit 2
